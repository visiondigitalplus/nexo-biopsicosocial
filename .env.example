# ---------------------------------------------------------------------------
# Nexo Biopsicosocial - variables de entorno
# Copia este archivo a .env y completa los valores.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Sesion / cifrado
# 32 bytes en base64: openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Clave maestra para cifrar la tabla clinica segregada (AES-256-GCM)
CLINICAL_ENCRYPTION_KEY=

# Base de datos. Si DATABASE_URL esta vacio se usa el driver de archivo
# (data/db.json) para desarrollo local y demos. En produccion: PostgreSQL 15+.
DATABASE_URL=postgres://user:password@localhost:5432/nexo
PGSSL=false

# Backoffice
ADMIN_TOKEN=cambia-esto-tambien

# Embudo comercial (opcional, el test funciona sin ellos)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
META_PIXEL_ID=
GOOGLE_ADS_ID=
TIKTOK_PIXEL_ID=
