{
  "name": "nexo-biopsychosocial",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma integrada de evaluacion biopsicosocial y desarrollo personal: test maestro de 18 items, motor psicometrico multirrasgo y prescripcion de microhabitos.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "invite": "node scripts/create-invite.js",
    "test": "node --test tests/",
    "build:static": "node scripts/build-static.js",
    "preview:static": "node scripts/serve-static.js",
    "test:static": "node scripts/test-static.mjs",
    "build": "node scripts/build-static.js",
    "wait-db": "node scripts/wait-for-db.js",
    "release": "node scripts/wait-for-db.js && node server/db/migrate.js && node server/db/seed.js",
    "smoke": "node scripts/smoke-server.mjs",
    "debug:db": "node --input-type=module -e \"import(\"./server/db/index.js\").then(async m=>{const {driver}=await m.getDb();console.log(await driver.select(\"access_invites\",{}));process.exit(0)})\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1"
  }
}
